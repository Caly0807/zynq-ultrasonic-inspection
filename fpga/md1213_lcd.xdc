# 常驻脉冲（已改到 ATK MODULE 的 KEY/LED）
set_property -dict {PACKAGE_PIN G14 IOSTANDARD LVCMOS33} [get_ports md1213_oe]
set_property -dict {PACKAGE_PIN N15 IOSTANDARD LVCMOS33} [get_ports md1213_ina]

# 系统
set_property -dict {PACKAGE_PIN U18 IOSTANDARD LVCMOS33} [get_ports sys_clk]
set_property -dict {PACKAGE_PIN N16 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports sys_rst_n]
set_property -dict {PACKAGE_PIN H15 IOSTANDARD LVCMOS33} [get_ports {led_n[0]}]
set_property -dict {PACKAGE_PIN L15 IOSTANDARD LVCMOS33} [get_ports {led_n[1]}]

# ADDA（J4）
set_property -dict {PACKAGE_PIN W15 IOSTANDARD LVCMOS33} [get_ports {ad_data[0]}]
set_property -dict {PACKAGE_PIN V15 IOSTANDARD LVCMOS33} [get_ports {ad_data[1]}]
set_property -dict {PACKAGE_PIN Y14 IOSTANDARD LVCMOS33} [get_ports {ad_data[2]}]
set_property -dict {PACKAGE_PIN W14 IOSTANDARD LVCMOS33} [get_ports {ad_data[3]}]
set_property -dict {PACKAGE_PIN W13 IOSTANDARD LVCMOS33} [get_ports {ad_data[4]}]
set_property -dict {PACKAGE_PIN V12 IOSTANDARD LVCMOS33} [get_ports {ad_data[5]}]
set_property -dict {PACKAGE_PIN U15 IOSTANDARD LVCMOS33} [get_ports {ad_data[6]}]
set_property -dict {PACKAGE_PIN U14 IOSTANDARD LVCMOS33} [get_ports {ad_data[7]}]
set_property -dict {PACKAGE_PIN U13 IOSTANDARD LVCMOS33} [get_ports ad_otr]
set_property -dict {PACKAGE_PIN V13 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports ad_clk]
set_property -dict {PACKAGE_PIN Y11 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports da_clk]
set_property -dict {PACKAGE_PIN Y12 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {da_data[0]}]
set_property -dict {PACKAGE_PIN Y13 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {da_data[1]}]
set_property -dict {PACKAGE_PIN V10 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {da_data[2]}]
set_property -dict {PACKAGE_PIN V11 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {da_data[3]}]
set_property -dict {PACKAGE_PIN W9  IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {da_data[4]}]
set_property -dict {PACKAGE_PIN W10 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {da_data[5]}]
set_property -dict {PACKAGE_PIN Y8  IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {da_data[6]}]
set_property -dict {PACKAGE_PIN Y9  IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {da_data[7]}]

# RGB LCD（800x480）
set_property -dict {PACKAGE_PIN P19 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports lcd_clk]
set_property -dict {PACKAGE_PIN U20 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports lcd_de]
set_property -dict {PACKAGE_PIN N18 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports lcd_hs]
set_property -dict {PACKAGE_PIN T20 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports lcd_vs]
set_property -dict {PACKAGE_PIN M20 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports lcd_bl]

set_property -dict {PACKAGE_PIN U17 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_r[7]}]
set_property -dict {PACKAGE_PIN T16 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_r[6]}]
set_property -dict {PACKAGE_PIN Y16 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_r[5]}]
set_property -dict {PACKAGE_PIN Y17 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_r[4]}]
set_property -dict {PACKAGE_PIN T15 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_r[3]}]
set_property -dict {PACKAGE_PIN T14 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_r[2]}]
set_property -dict {PACKAGE_PIN W16 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_r[1]}]
set_property -dict {PACKAGE_PIN V16 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_r[0]}]

set_property -dict {PACKAGE_PIN P16 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_g[7]}]
set_property -dict {PACKAGE_PIN P15 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_g[6]}]
set_property -dict {PACKAGE_PIN Y19 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_g[5]}]
set_property -dict {PACKAGE_PIN Y18 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_g[4]}]
set_property -dict {PACKAGE_PIN J14 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_g[3]}]
set_property -dict {PACKAGE_PIN K14 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_g[2]}]
set_property -dict {PACKAGE_PIN V18 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_g[1]}]
set_property -dict {PACKAGE_PIN V17 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_g[0]}]

set_property -dict {PACKAGE_PIN N17 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_b[7]}]
set_property -dict {PACKAGE_PIN P18 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_b[6]}]
set_property -dict {PACKAGE_PIN V20 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_b[5]}]
set_property -dict {PACKAGE_PIN W20 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_b[4]}]
set_property -dict {PACKAGE_PIN R17 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_b[3]}]
set_property -dict {PACKAGE_PIN R16 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_b[2]}]
set_property -dict {PACKAGE_PIN W19 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_b[1]}]
set_property -dict {PACKAGE_PIN W18 IOSTANDARD LVCMOS33 DRIVE 8} [get_ports {lcd_b[0]}]

create_clock -period 20.000 -name sys_clk [get_ports sys_clk]
