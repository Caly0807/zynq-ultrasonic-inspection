create_generated_clock -name ad_clk_ext -source [get_pins adc_clock_forward/C] -divide_by 1 [get_ports ad_clk]
create_generated_clock -name da_clk_ext -source [get_pins dac_clock_forward/C] -divide_by 1 [get_ports da_clk]
create_generated_clock -name lcd_clk_ext -source [get_pins lcd_clock_forward/C] -divide_by 1 -invert [get_ports lcd_clk]
set_input_delay -clock ad_clk_ext -max 12.000 [get_ports {ad_data[*] ad_otr}]
set_input_delay -clock ad_clk_ext -min 2.000 [get_ports {ad_data[*] ad_otr}]
set_output_delay -clock da_clk_ext -max 2.000 [get_ports {da_data[*]}]
set_output_delay -clock da_clk_ext -min 0.000 [get_ports {da_data[*]}]
set_output_delay -clock lcd_clk_ext -max 2.000 [get_ports {lcd_r[*] lcd_g[*] lcd_b[*] lcd_de lcd_hs lcd_vs}]
set_output_delay -clock lcd_clk_ext -min 0.000 [get_ports {lcd_r[*] lcd_g[*] lcd_b[*] lcd_de lcd_hs lcd_vs}]
set_output_delay -clock sys_clk -max 2.000 [get_ports {md1213_oe md1213_ina led_n[*] lcd_bl}]
set_output_delay -clock sys_clk -min 0.000 [get_ports {md1213_oe md1213_ina led_n[*] lcd_bl}]
set_false_path -from [get_ports sys_rst_n]
